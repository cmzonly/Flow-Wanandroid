<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shapelayout"
    app:shape_radius="20dp"
    android:layout_marginStart="16dp"
    app:shape_strokeColor="@color/theme"
    app:shape_strokeSize="2dp"
    android:layout_marginBottom="20dp"
    android:layout_marginEnd="16dp"
    android:layout_height="260dp">

    <TextView
        android:ellipsize="end"
        android:maxLines="2"
        android:id="@+id/tv_title"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:gravity="center"
        style="@style/tv_black_bold_28"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <View
        android:id="@+id/view_background"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/black_50"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <TextView
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/view_background"
        app:layout_constraintStart_toStartOf="parent"
        android:ellipsize="end"
        android:maxLines="4"
        android:id="@+id/tv_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        style="@style/tv_gray_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>





</com.hjq.shape.layout.ShapeConstraintLayout>