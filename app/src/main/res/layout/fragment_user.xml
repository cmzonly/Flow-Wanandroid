<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="100dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

   <com.hjq.shape.view.ShapeImageView
       app:layout_constraintEnd_toStartOf="@id/tv_username"
       app:shape_strokeSize="2dp"
       app:shape_strokeColor="@color/white"
       android:src="@drawable/tx"
       app:shape_radius="120dp"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       android:id="@+id/iv_heard"
       android:layout_width="100dp"
       android:layout_height="100dp"/>

    <TextView
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/tv_username"
        app:layout_constraintStart_toEndOf="@id/iv_heard"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="26sp"
      app:layout_constraintTop_toTopOf="@id/iv_heard"
        app:layout_constraintBottom_toBottomOf="@id/iv_heard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <View
        android:id="@+id/view_line"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/iv_heard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="#ebebeb"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>

    <androidx.core.widget.NestedScrollView
        android:overScrollMode="never"
        android:id="@+id/nsv"
        app:layout_constraintTop_toBottomOf="@id/view_line"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.hjq.shape.view.ShapeButton
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/btn_collect"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/sc"
                android:textStyle="bold"
                android:textSize="18sp"
                android:text="收藏列表"
                app:layout_constraintTop_toTopOf="parent"
                android:padding="16dp"
                app:shape_radius="20dp"
                app:shape_solidColor="@color/white"
                android:layout_width="200dp"
                android:layout_height="wrap_content"/>

            <com.hjq.shape.view.ShapeButton
                android:id="@+id/btn_loginout"
                android:layout_marginTop="16dp"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/tc"
                android:textStyle="bold"
                android:textSize="18sp"
                android:text="退出登录"
                android:padding="16dp"
                app:shape_radius="20dp"
                app:shape_solidColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_collect"
                android:layout_width="200dp"
                android:layout_height="wrap_content"/>

            <com.hjq.shape.view.ShapeButton
                android:layout_marginTop="16dp"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/yy"
                android:textStyle="bold"
                android:textSize="18sp"
                android:text="应用信息"
                android:padding="16dp"
                app:shape_radius="20dp"
                app:shape_solidColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_loginout"
                android:layout_width="200dp"
                android:layout_height="wrap_content"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>