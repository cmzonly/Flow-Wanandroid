<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.hjq.shape.view.ShapeTextView
        android:layout_marginTop="16dp"
        android:id="@+id/tv_hot"
        style="@style/tv_black_bold_26"
        android:text="@string/hot"
        android:drawablePadding="10dp"
        android:drawableEnd="@drawable/hot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_hot"
        android:id="@+id/rv_hot"
        android:layout_width="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"/>

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_like"
        android:layout_marginTop="16dp"
        style="@style/tv_black_bold_26"
        android:text="@string/like"
        android:drawablePadding="10dp"
        android:drawableEnd="@drawable/like"
        app:layout_constraintStart_toStartOf="@id/rv_hot"
        app:layout_constraintTop_toBottomOf="@id/rv_hot"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>