<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

   <com.hjq.shape.view.ShapeEditText
       android:layout_marginEnd="20dp"
       android:textSize="20sp"
       android:hint="@string/hint_tip"
       android:paddingStart="20dp"
       android:paddingEnd="20dp"
       app:shape_strokeSize="1dp"
       app:shape_strokeColor="@color/black_50"
       android:layout_marginTop="10dp"
       android:layout_marginStart="20dp"
       app:shape_solidColor="@color/white"
       android:gravity="start|center_vertical"
       android:id="@+id/et"
       app:shape_radius="120dp"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintEnd_toStartOf="@id/btn_search"
       android:layout_width="0dp"
       android:layout_height="60dp"/>

    <com.hjq.shape.view.ShapeButton
        android:visibility="gone"
        android:textSize="24sp"
        android:layout_marginEnd="20dp"
        android:id="@+id/btn_search"
        android:gravity="center"
        android:text="@string/search"
        app:shape_radius="120dp"
        app:shape_solidColor="@color/theme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/et"
        android:layout_width="100dp"
        android:layout_height="60dp"/>

    <ImageView
        android:visibility="gone"
        android:id="@+id/iv_close"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@id/et"
        app:layout_constraintTop_toTopOf="@id/et"
        app:layout_constraintEnd_toEndOf="@id/et"
        android:src="@drawable/close"
        android:layout_width="40dp"
        android:layout_height="40dp"/>


    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:id="@+id/rv_top"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/et"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="0dp"
        android:layout_height="0dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:background="@color/white"
        android:visibility="gone"
        android:id="@+id/rv_search"
        android:layout_marginTop="20sp"
        app:layout_constraintTop_toBottomOf="@id/et"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="0dp"
        android:layout_height="0dp"/>

    <com.github.ybq.android.spinkit.SpinKitView
        android:visibility="gone"
        app:SpinKit_Color="@color/theme"
        style="@style/SpinKitView.Large.Wave"
        app:layout_constraintTop_toBottomOf="@id/et"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/spinkitview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>