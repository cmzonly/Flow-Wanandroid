<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shape_solidGradientStartColor="@color/theme_q"
    app:shape_solidGradientEndColor="@color/theme"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:layout_marginTop="100dp"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:padding="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shape_radius="20dp"
        app:shape_solidColor="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.hjq.shape.view.ShapeImageView
            app:layout_constraintBottom_toTopOf="@id/et_userName"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/iv_tx"
            android:scaleType="centerCrop"
            android:src="@drawable/tx"
            app:shape_radius="120dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="120dp"
            android:layout_height="120dp"/>

        <com.hjq.shape.view.ShapeEditText
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:shape_radius="20dp"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/userpic"
            app:shape_strokeColor="@color/black_50"
            app:shape_strokeSize="1dp"
            app:shape_solidColor="@color/white"
            android:hint="请输入用户名"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/iv_tx"
            app:layout_constraintBottom_toTopOf="@id/et_passWord"
            app:layout_constraintEnd_toEndOf="@id/iv_tx"
            app:layout_constraintStart_toStartOf="@id/iv_tx"
            android:id="@+id/et_userName"
            android:layout_width="200dp"
            android:layout_height="wrap_content"/>

        <com.hjq.shape.view.ShapeEditText
            android:inputType="textPassword"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:shape_radius="20dp"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/passwordpic"
            app:shape_strokeColor="@color/black_50"
            app:shape_strokeSize="1dp"
            app:shape_solidColor="@color/white"
            android:hint="请输入密码"
            android:textColor="@color/black"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_userName"
            app:layout_constraintBottom_toTopOf="@id/et_passWord_agin"
            android:id="@+id/et_passWord"
            android:layout_width="200dp"
            android:layout_height="wrap_content"/>

        <com.hjq.shape.view.ShapeEditText
            android:inputType="textPassword"
            app:layout_constraintBottom_toTopOf="@id/btn_register"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:shape_radius="20dp"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/passwordpic"
            app:shape_strokeColor="@color/black_50"
            app:shape_strokeSize="1dp"
            android:hint="请再次输入密码"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_passWord"
            android:id="@+id/et_passWord_agin"
            android:layout_width="200dp"
            android:layout_height="wrap_content"/>

        <com.hjq.shape.view.ShapeButton
            app:shape_radius="120dp"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/btn_login"
            app:layout_constraintTop_toBottomOf="@id/et_passWord_agin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shape_solidColor="@color/theme"
            android:text="注册"
            android:id="@+id/btn_register"
            android:layout_width="200dp"
            android:layout_height="wrap_content"/>

        <com.hjq.shape.view.ShapeButton
            app:shape_radius="120dp"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/btn_register"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shape_solidColor="@color/theme"
            android:text="登录"
            android:id="@+id/btn_login"
            android:layout_width="200dp"
            android:layout_height="wrap_content"/>



    </com.hjq.shape.layout.ShapeConstraintLayout>





</com.hjq.shape.layout.ShapeConstraintLayout>